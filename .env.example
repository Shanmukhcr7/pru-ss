# ParentVision Environment Configuration Template
# Copy this file to .env and configure strong secrets before deployment.

# 1. Domain & Networking
DOMAIN=parentvision.yourdomain.com
HOST=0.0.0.0
PORT=4000
NODE_ENV=production

# 2. PostgreSQL Database Credentials
POSTGRES_USER=parentvision_admin
POSTGRES_PASSWORD=generate_strong_db_password_here
POSTGRES_DB=parentvision
DATABASE_URL=postgresql://parentvision_admin:generate_strong_db_password_here@postgres:5432/parentvision

# 3. Authentication & JWT Secrets (Generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET=replace_with_openssl_rand_hex_32_access_secret
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32_refresh_secret
JWT_DEVICE_SECRET=replace_with_openssl_rand_hex_32_device_secret
JWT_SESSION_SECRET=replace_with_openssl_rand_hex_32_session_secret

# 4. WebRTC STUN & Coturn TURN Relay Configuration
# Shared secret must match `static-auth-secret` in turnserver.conf
TURN_SECRET=replace_with_openssl_rand_hex_32_turn_secret
TURN_REALM=turn.parentvision.yourdomain.com
TURN_URLS=stun:turn.parentvision.yourdomain.com:3478,turn:turn.parentvision.yourdomain.com:3478?transport=udp

# 5. Dashboard Frontend Public URLs
NEXT_PUBLIC_API_URL=https://parentvision.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://parentvision.yourdomain.com
